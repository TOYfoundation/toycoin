## NFT item catalog for TOYQUEST 3D.
##
## Read-only lookups: names, minting fees, rarity, bonuses and gang
## synergies. The data file res://data/nft_items.json is generated by
## toypay/tools/gen_nft_items.py from toypay/data/nft_items.tsv.
##
## Minting happens on Polygon through the TOYPAY app with a voucher from
## the game server. This script never touches keys, seed phrases or tokens.
## The rule constants mirror docs/02-entscheidungen.md (decisions 19-26);
## the NFT contract enforces them again on-chain.
class_name NftItems
extends RefCounted

const CATALOG_PATH := "res://data/nft_items.json"

# Minting rules (decisions 19-22, 26). On-chain enforcement is authoritative.
const MIN_BALANCE_TOY := 100
const LOCK_TOY_PER_NFT := 10
const LOCK_DAYS := 20
const CHARACTER_FEE_TOY := 1
const CHARACTER_MIN_LEVEL := 20
const ITEMS_BEFORE_NEXT_CHARACTER := 5
const MAX_CHARACTERS_MINTED := 5
const MAX_ITEMS_MINTED := 50
const MAX_CHARACTERS_PER_WEEK := 1
const MAX_ITEMS_PER_WEEK := 10
const MAX_ACTIVE_GANG := 5

# Fixed in-game rate (decision 23). One-way: TOY -> Dukaten only (decision 25).
const DUKATEN_PER_TOY := 100
const GOLD_PER_TOY := 1000

static var _catalog: Dictionary = {}
static var _by_id: Dictionary = {}
static var _by_type: Dictionary = {}


## Loads the catalog once. Returns false (and logs an error) if the file is
## missing or malformed.
static func load_catalog(path: String = CATALOG_PATH) -> bool:
	if not _by_id.is_empty():
		return true
	if not FileAccess.file_exists(path):
		push_error("NftItems: catalog not found at %s" % path)
		return false
	var data = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(data) != TYPE_DICTIONARY or not data.has("items"):
		push_error("NftItems: catalog is not valid JSON")
		return false
	_catalog = data
	for item in data["items"]:
		item["item_type"] = int(item["item_type"])
		item["fee_toy"] = int(item["fee_toy"])
		item["fee_dukaten"] = int(item["fee_dukaten"])
		item["fee_gold"] = int(item["fee_gold"])
		var bonuses := {}
		for stat in item["bonuses"]:
			bonuses[stat] = int(item["bonuses"][stat])
		item["bonuses"] = bonuses
		_by_id[item["id"]] = item
		_by_type[item["item_type"]] = item
	return true


## Clears the cache (used by tests).
static func unload() -> void:
	_catalog = {}
	_by_id = {}
	_by_type = {}


static func count() -> int:
	return _by_id.size()


static func has_item(id: String) -> bool:
	return _by_id.has(id)


## Returns the item dictionary, or an empty dictionary if unknown.
static func get_item(id: String) -> Dictionary:
	return _by_id.get(id, {})


## Looks up by the on-chain item type number.
static func get_by_type(item_type: int) -> Dictionary:
	return _by_type.get(item_type, {})


static func all_items() -> Array:
	return _catalog.get("items", [])


static func items_in_category(category: String) -> Array:
	return all_items().filter(func(i): return i["category"] == category)


static func categories() -> Array:
	return _catalog.get("categories", {}).keys()


## Translation key for the game's i18n tables (tools/i18n/master_nftitems.tsv).
static func name_key(id: String) -> String:
	return get_item(id).get("name_key", "")


## Fallback name if the i18n system has no entry: German for "de", else English.
static func display_name(id: String, lang: String = "en") -> String:
	var item := get_item(id)
	if item.is_empty():
		return id
	return item["name_de"] if lang == "de" else item["name_en"]


static func fee_toy(id: String) -> int:
	return get_item(id).get("fee_toy", 0)


static func fee_dukaten(id: String) -> int:
	return get_item(id).get("fee_dukaten", 0)


static func rarity(id: String) -> String:
	return get_item(id).get("rarity", "")


static func bonuses(id: String) -> Dictionary:
	return get_item(id).get("bonuses", {})


## What a player needs on the wallet to mint this item: minimum balance
## (checked before minting) plus the fee and the refundable lock.
static func mint_requirements(id: String) -> Dictionary:
	var fee := fee_toy(id)
	return {
		"fee_toy": fee,
		"lock_toy": LOCK_TOY_PER_NFT,
		"lock_days": LOCK_DAYS,
		"min_balance_toy": max(MIN_BALANCE_TOY, fee + LOCK_TOY_PER_NFT),
	}


## Sums the bonuses of all items a gang can use (shared assets).
## Unknown ids are ignored.
static func gang_bonus(item_ids: Array) -> Dictionary:
	var total := {}
	for id in item_ids:
		var b := bonuses(id)
		for stat in b:
			total[stat] = total.get(stat, 0) + b[stat]
	return total


## Converts a TOY amount (whole TOY) to Dukaten at the fixed rate.
static func toy_to_dukaten(toy: int) -> int:
	return toy * DUKATEN_PER_TOY


# --- Rarity, epithets, level requirements (docs: 07_SPIELDESIGN.md) ---

## Rarity info: {key, de, en, color, min_level, vfx_tier, min_fee, max_fee}.
static func rarity_info(key: String) -> Dictionary:
	for r in _catalog.get("rarities", []):
		if r["key"] == key:
			return r
	return {}


static func rarity_color(id: String) -> Color:
	var info := rarity_info(rarity(id))
	return Color(info.get("color", "#FFFFFF"))


## 0 = Sand Grain ... 4 = Starfire. Drives the VFX intensity.
static func vfx_tier(id: String) -> int:
	return int(rarity_info(rarity(id)).get("vfx_tier", 0))


static func min_level(id: String) -> int:
	return int(get_item(id).get("min_level", 1))


## True if a character of this level may use the item.
static func can_use(id: String, character_level: int) -> bool:
	return has_item(id) and character_level >= min_level(id)


## Edition cap per item type (decision 33): 1001 for Starfire, 0 = unlimited.
static func max_supply(id: String) -> int:
	var v = get_item(id).get("max_supply")
	return 0 if v == null else int(v)


## Edition cap per item type and season of 101 nights (decision 46):
## 1001 for Ruby Glow, 101 for Starfire, 0 = unlimited.
static func season_supply(id: String) -> int:
	var v = get_item(id).get("season_supply")
	return 0 if v == null else int(v)


## Playful epithet of precious and legendary items, "" if none.
static func epithet(id: String, lang: String = "en") -> String:
	var item := get_item(id)
	return item.get("epithet_de" if lang == "de" else "epithet_en", "")


# --- Gang: classes, duos, sets, stacking (data: gang.json) ---

static func _gang() -> Dictionary:
	return _catalog.get("gang", {})


static func classes() -> Array:
	return _gang().get("classes", [])


static func get_class_info(class_id: String) -> Dictionary:
	for c in classes():
		if c["id"] == class_id:
			return c
	return {}


## Duos whose two classes are both among the active gang classes.
static func active_duos(active_classes: Array) -> Array:
	return _gang().get("duos", []).filter(
		func(d): return active_classes.has(d["classes"][0]) and active_classes.has(d["classes"][1]))


## Sets whose items are all owned by the address.
static func completed_sets(owned_item_ids: Array) -> Array:
	return _gang().get("sets", []).filter(
		func(s): return s["items"].all(func(i): return owned_item_ids.has(i)))


static func is_full_caravan(active_classes: Array) -> bool:
	var distinct := {}
	for c in active_classes:
		distinct[c] = true
	return distinct.size() >= MAX_ACTIVE_GANG


static func _add(target: Dictionary, effects: Dictionary) -> void:
	for k in effects:
		target[k] = target.get(k, 0) + effects[k]


## Gang totals for one character of the gang.
## - Item bonuses per stat: strongest counts fully, next x0.75, rest x0.5
##   (gang.json limits.stacking_factors), capped at +12 per stat.
## - Plus class auras, active duos and completed sets.
## - Full caravan (5 different classes): +10 % on all stats.
## Returns {"stats": {stat: int}, "effects": {special_key: number},
##          "duos": [ids], "sets": [ids], "full_caravan": bool}.
static func gang_stats(active_classes: Array, owned_item_ids: Array) -> Dictionary:
	var limits: Dictionary = _gang().get("limits", {})
	var factors: Array = limits.get("stacking_factors", [1.0, 0.75, 0.5])
	var cap := int(limits.get("stat_cap_from_items_per_character", 12))
	var stat_keys: Dictionary = _catalog.get("stats", {})

	# 1. Items with diminishing returns per stat.
	var per_stat := {}
	for id in owned_item_ids:
		var b := bonuses(id)
		for stat in b:
			if not per_stat.has(stat):
				per_stat[stat] = []
			per_stat[stat].append(b[stat])
	var stats := {}
	for stat in per_stat:
		var values: Array = per_stat[stat]
		values.sort()
		values.reverse()
		var total := 0.0
		for i in values.size():
			total += values[i] * float(factors[min(i, factors.size() - 1)])
		stats[stat] = min(int(round(total)), cap)

	# 2. Auras, duos and sets; split real stats from special effects.
	var extra := {}
	for c in active_classes:
		_add(extra, get_class_info(c).get("aura", {}))
	var duos := active_duos(active_classes)
	for d in duos:
		_add(extra, d["effect"])
	var sets := completed_sets(owned_item_ids)
	for s in sets:
		_add(extra, s["bonus"])
	var effects := {}
	for k in extra:
		if stat_keys.has(k):
			stats[k] = stats.get(k, 0) + int(extra[k])
		else:
			effects[k] = extra[k]

	# 3. Full caravan.
	var full := is_full_caravan(active_classes)
	if full:
		var pct := float(limits.get("full_caravan_bonus_pct", 10)) / 100.0
		for k in stats:
			stats[k] = int(round(stats[k] * (1.0 + pct)))

	return {
		"stats": stats,
		"effects": effects,
		"duos": duos.map(func(d): return d["id"]),
		"sets": sets.map(func(s): return s["id"]),
		"full_caravan": full,
	}


## Experience needed to go from `level` to `level + 1`: 100 * level^1.6.
static func xp_to_next(level: int) -> int:
	var curve: Dictionary = _gang().get("limits", {}).get("xp_curve", {"base": 100, "exponent": 1.6})
	return int(round(float(curve["base"]) * pow(level, float(curve["exponent"]))))


## Random funny gang name from gang.json (free re-roll, no paid randomness).
static func random_gang_name(lang: String = "de", rng: RandomNumberGenerator = null) -> String:
	var parts: Dictionary = _gang().get("gang_name_parts", {})
	var first: Array = parts.get(lang + "_first", parts.get("en_first", ["Gang"]))
	var second: Array = parts.get(lang + "_second", parts.get("en_second", [""]))
	var r: RandomNumberGenerator = rng if rng != null else RandomNumberGenerator.new()
	return "%s %s" % [first[r.randi_range(0, first.size() - 1)], second[r.randi_range(0, second.size() - 1)]]
