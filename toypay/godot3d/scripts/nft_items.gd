## NFT item catalog for TOYQUEST 3D.
##
## Read-only lookups: names, minting fees, rarity, bonuses and gang
## synergies. The data file res://data/nft_items.json is generated by
## toypay/tools/gen_nft_items.py from toypay/data/nft_items.tsv.
##
## Minting happens on Polygon through the TOYPAY app with a voucher from
## the game server. This script never touches keys, seed phrases or tokens.
## The rule constants mirror docs/02-entscheidungen.md (decisions 19-26);
## the NFT contract enforces them again on-chain.
class_name NftItems
extends RefCounted

const CATALOG_PATH := "res://data/nft_items.json"

# Minting rules (decisions 19-22, 26). On-chain enforcement is authoritative.
const MIN_BALANCE_TOY := 100
const LOCK_TOY_PER_NFT := 10
const LOCK_DAYS := 20
const CHARACTER_FEE_TOY := 1
const CHARACTER_MIN_LEVEL := 20
const ITEMS_BEFORE_NEXT_CHARACTER := 5
const MAX_CHARACTERS_MINTED := 5
const MAX_ITEMS_MINTED := 50
const MAX_CHARACTERS_PER_WEEK := 1
const MAX_ITEMS_PER_WEEK := 10
const MAX_ACTIVE_GANG := 5

# Fixed in-game rate (decision 23). One-way: TOY -> Dukaten only (decision 25).
const DUKATEN_PER_TOY := 100
const GOLD_PER_TOY := 1000

static var _catalog: Dictionary = {}
static var _by_id: Dictionary = {}
static var _by_type: Dictionary = {}


## Loads the catalog once. Returns false (and logs an error) if the file is
## missing or malformed.
static func load_catalog(path: String = CATALOG_PATH) -> bool:
	if not _by_id.is_empty():
		return true
	if not FileAccess.file_exists(path):
		push_error("NftItems: catalog not found at %s" % path)
		return false
	var data = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(data) != TYPE_DICTIONARY or not data.has("items"):
		push_error("NftItems: catalog is not valid JSON")
		return false
	_catalog = data
	for item in data["items"]:
		item["item_type"] = int(item["item_type"])
		item["fee_toy"] = int(item["fee_toy"])
		item["fee_dukaten"] = int(item["fee_dukaten"])
		item["fee_gold"] = int(item["fee_gold"])
		var bonuses := {}
		for stat in item["bonuses"]:
			bonuses[stat] = int(item["bonuses"][stat])
		item["bonuses"] = bonuses
		_by_id[item["id"]] = item
		_by_type[item["item_type"]] = item
	return true


## Clears the cache (used by tests).
static func unload() -> void:
	_catalog = {}
	_by_id = {}
	_by_type = {}


static func count() -> int:
	return _by_id.size()


static func has_item(id: String) -> bool:
	return _by_id.has(id)


## Returns the item dictionary, or an empty dictionary if unknown.
static func get_item(id: String) -> Dictionary:
	return _by_id.get(id, {})


## Looks up by the on-chain item type number.
static func get_by_type(item_type: int) -> Dictionary:
	return _by_type.get(item_type, {})


static func all_items() -> Array:
	return _catalog.get("items", [])


static func items_in_category(category: String) -> Array:
	return all_items().filter(func(i): return i["category"] == category)


static func categories() -> Array:
	return _catalog.get("categories", {}).keys()


## Translation key for the game's i18n tables (tools/i18n/master_nftitems.tsv).
static func name_key(id: String) -> String:
	return get_item(id).get("name_key", "")


## Fallback name if the i18n system has no entry: German for "de", else English.
static func display_name(id: String, lang: String = "en") -> String:
	var item := get_item(id)
	if item.is_empty():
		return id
	return item["name_de"] if lang == "de" else item["name_en"]


static func fee_toy(id: String) -> int:
	return get_item(id).get("fee_toy", 0)


static func fee_dukaten(id: String) -> int:
	return get_item(id).get("fee_dukaten", 0)


static func rarity(id: String) -> String:
	return get_item(id).get("rarity", "")


static func bonuses(id: String) -> Dictionary:
	return get_item(id).get("bonuses", {})


## What a player needs on the wallet to mint this item: minimum balance
## (checked before minting) plus the fee and the refundable lock.
static func mint_requirements(id: String) -> Dictionary:
	var fee := fee_toy(id)
	return {
		"fee_toy": fee,
		"lock_toy": LOCK_TOY_PER_NFT,
		"lock_days": LOCK_DAYS,
		"min_balance_toy": max(MIN_BALANCE_TOY, fee + LOCK_TOY_PER_NFT),
	}


## Sums the bonuses of all items a gang can use (shared assets).
## Unknown ids are ignored.
static func gang_bonus(item_ids: Array) -> Dictionary:
	var total := {}
	for id in item_ids:
		var b := bonuses(id)
		for stat in b:
			total[stat] = total.get(stat, 0) + b[stat]
	return total


## Converts a TOY amount (whole TOY) to Dukaten at the fixed rate.
static func toy_to_dukaten(toy: int) -> int:
	return toy * DUKATEN_PER_TOY
